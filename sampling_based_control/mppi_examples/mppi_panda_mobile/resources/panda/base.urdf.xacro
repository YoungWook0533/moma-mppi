<?xml version="1.0" encoding="utf-8"?>
<robot name="panda_mobile" xmlns:xacro="http://www.ros.org/wiki/xacro">

    <xacro:macro name="add_transmission" params="joint_name">
        <transmission name="transmision_${joint_name}">
            <type>transmission_interface/SimpleTransmission</type>
            <joint name="${joint_name}">
                <hardwareInterface>hardware_interface/EffortJointInterface</hardwareInterface>
            </joint>
            <actuator name="${joint_name}_motor">
                <mechanicalReduction>1</mechanicalReduction>
            </actuator>
        </transmission>
    </xacro:macro>

    <xacro:macro name="panda_base" params="base_link:='base'">
        <link name="world"/>
        <link name="x_link">
            <inertial>
                <origin xyz="0 0 0" rpy="0 0 0" />
                <mass value="3.06"/>
                <inertia ixx="0.3" ixy="0.0" ixz="0.0" iyy="0.3" iyz="0.0" izz="0.3" />
            </inertial>
        </link>

        <joint name="x_base_joint" type="prismatic">
            <origin rpy="0 0 0" xyz="0 0 0"/>
            <axis xyz="1 0 0"/>
            <parent link="world"/>
            <child link="x_link"/>
            <limit lower="-10" upper="10" effort="200" velocity="2"/>
        </joint>
        <xacro:add_transmission joint_name="x_base_joint"/>

        <link name="y_link">
            <inertial>
                <origin xyz="0 0 0" rpy="0 0 0" />
                <mass value="3.06"/>
                <inertia ixx="0.3" ixy="0.0" ixz="0.0" iyy="0.3" iyz="0.0" izz="0.3" />
            </inertial>
        </link>

        <joint name="y_base_joint" type="prismatic">
            <origin rpy="0 0 0" xyz="0 0 0"/>
            <axis xyz="0 1 0"/>
            <parent link="x_link"/>
            <child link="y_link"/>
            <limit lower="-10" upper="10" effort="200" velocity="2"/>
        </joint>
        <xacro:add_transmission joint_name="y_base_joint"/>

        <joint name="w_base_joint" type="revolute">
            <origin rpy="0 0 0" xyz="0 0 0"/>
            <axis xyz="0 0 1"/>
            <parent link="y_link"/>
            <child link="${base_link}"/>
            <limit effort="200" velocity="2" upper="30" lower="-30"/>
        </joint>
        <xacro:add_transmission joint_name="w_base_joint"/>

        <link name="${base_link}">
            <collision>
                <origin xyz="0 0 0" rpy="0 0 0"/>
                <geometry>
                    <box size="0.5 0.5 0.25"/>
                </geometry>
            </collision>
            <visual>
                <origin xyz="0 0 0" rpy="0 0 0"/>
                <geometry>
                    <box size="0.5 0.5 0.25"/>
                </geometry>
            </visual>
        </link>
    </xacro:macro>

</robot>
