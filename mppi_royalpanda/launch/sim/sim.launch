<?xml version="1.0"?>
<launch>
    <arg name="fixed_base" default="false"/>
    <rosparam command="load" file="$(find summit_package)/config/robot_control.yaml" />

    <include file="$(find mppi_royalpanda)/launch/robot/observer.launch">
        <arg name="simulation" value="false"/>
        <arg name="fixed_base" value="false"/>
    </include>

    <include file="$(find mppi_royalpanda)/launch/robot/controller.launch">
        <arg name="simulation" value="false"/>
        <arg name="fixed_base" value="false"/>
    </include>

    <include file="$(find mppi_manipulation)/launch/common.launch">
        <!-- <arg name="plot_cost" default="false"/>
        <arg name="plot_input" default="false"/> -->
        <arg name="enable_obstacle" default="false"/>
    </include>

    <!-- <node name="controller_manager_gui" type="rqt_controller_manager" pkg="rqt_controller_manager" output="screen"/> -->
    <!-- <node name="collision_detection_node" pkg="mppi_royalpanda" type="ssv_model"/> -->
    <node pkg="mppi_royalpanda" type="controller_node" name="manipulation_controller_sim" output="screen" />
    <node pkg="mppi_royalpanda" type="input_to_controller" name="input_to_controller_node" output="screen" />
</launch>

<!-- rostopic pub /panda_position_controller/command std_msgs/Float64MultiArray "{data: [0.0, 1.0, 0.0, 0.4, 0.0, 0.17, 0.0]}" -->
